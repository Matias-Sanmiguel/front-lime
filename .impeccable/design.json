  "narrative": {
    "northStar": "Claridad para encontrar tu lugar",
    "overview": "Este nombre describe la implementación; no se presenta como una elección textual del usuario. La dirección confirmada es una identidad nueva, minimalista y linda, con referencia estética Apple y logo propio. Reemplaza el mundo editorial anterior: blancos y grises fríos, tipografía sans serif y fotografías de propiedades como protagonistas.\n\nLa calma visual surge del espacio, de una jerarquía breve y de controles familiares. El lima suave y su verde de contraste son una elección de implementación pendiente de la preferencia cromática del usuario. Este documento es la referencia visual del frontend; los valores normativos están en el frontmatter y se corresponden con el código actual.",
    "keyCharacteristics": [
      "Superficies claras y contraste de grafito.",
      "Una sola familia tipográfica: Inter.",
      "Fotografías protagonistas y datos fáciles de comparar.",
      "Logo geométrico propio, abierto y de trazos redondeados.",
      "Movimiento breve y profundidad discreta."
    ],
    "rules": [
      {
        "name": "The Contrast Rule",
        "body": "Usar grafito para la acción primaria y verde de contraste para el texto acentuado; el lima suave no funciona como texto sobre blanco.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do usar los tokens compartidos para color, radio y tipografía.",
      "Do mantener los precios y las fotografías como información principal de las tarjetas.",
      "Do comprobar el diseño a 390 px y 1440 px, con teclado y movimiento reducido.",
      "Do conservar los estados de carga, vacío, error y fotografía ausente."
    ],
    "donts": [
      "Don't reintroducir la identidad editorial anterior como norma del frontend.",
      "Don't copiar logotipos ni activos propietarios de Apple.",
      "Don't presentar el acento lima como una preferencia confirmada del usuario.",
      "Don't inventar métricas, testimonios o garantías para completar una composición."
    ]
  }
